{
  "productName": "Ovule",
  "app": {
    "identifier": "io.ovule.desktop"
  },
  "build": {
    "devUrl": "http://127.0.0.1:5173/main",
    "beforeDevCommand": {
      "script": "bun run dev -- --port 5173",
      "cwd": "desktop"
    },
    "beforePackageCommand": {
      "script": "bun run build",
      "cwd": "desktop"
    },
    "devtoolsPort": 9234,
    "mojomSources": ["desktop/packages/ovule-shell-api/shell_api.mojom"]
  },
  "bundle": {
    "icons": {
      "macos": "desktop/branding/app-icon.icns",
      "windows": "desktop/branding/app-icon.ico"
    },
    "resources": ["LICENSE", "desktop/dist"]
  }
}
