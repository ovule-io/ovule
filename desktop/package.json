{
  "name": "ovule-desktop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "type": "module",
  "scripts": {
    "smoke:build-channels": "node smoke/build-channels.mjs",
    "dev": "bun run build:app && vite --config vite.config.mjs",
    "build": "bun run build:extensions && bun run build:app",
    "format": "prettier --write src features tests scripts smoke package.json vite.config.mjs eslint.config.mjs",
    "format:check": "prettier --check src features tests scripts smoke package.json vite.config.mjs eslint.config.mjs",
    "typecheck": "tsc -p tsconfig.extensions.json && bun run --cwd packages/ovule-ioc typecheck && bun run --cwd packages/ovule-ioc-container typecheck && bun run --cwd packages/ovule-ui typecheck && node scripts/typecheck.mjs tsconfig.features.json && bun run typecheck:app",
    "smoke": "node smoke/smoke.mjs",
    "smoke:settings": "node smoke/settings-smoke.mjs",
    "smoke:settings-composer": "node smoke/settings-composer-smoke.mjs",
    "test:vite-plugin": "node scripts/vite-plugin.test.mjs && node --test scripts/client-directives-plugin.test.mjs",
    "lint": "eslint src features && bun run lint:boundaries",
    "lint:boundaries": "node scripts/check-feature-packages.mjs",
    "test:architecture": "bun test --preload ./tests/bundler-assets.ts ./src ./features ./tests && bun run lint:boundaries",
    "smoke:native": "node smoke/native-ui.mjs",
    "smoke:thread-surface": "node smoke/thread-surface.mjs",
    "smoke:thread-stress": "node smoke/thread-surface.mjs --stress",
    "smoke:explorer-promotion": "node smoke/explorer-promotion-smoke.mjs",
    "smoke:explorer-resources": "node smoke/explorer-resources-smoke.mjs",
    "smoke:spa": "node smoke/spa-workbench-smoke.mjs",
    "smoke:theme": "node smoke/theme-smoke.mjs",
    "smoke:explorer-promotion-native": "node smoke/explorer-promotion-native-smoke.mjs",
    "smoke:explorer-promotion-dev": "node smoke/explorer-promotion-dev-smoke.mjs",
    "build:extensions": "bun run scripts/build-extensions.ts",
    "build:visuals": "bun run scripts/build-extensions.ts visuals",
    "build:app": "node scripts/typecheck.mjs tsconfig.app.json && vite build --config vite.config.mjs",
    "typecheck:app": "node scripts/typecheck.mjs tsconfig.app.json",
    "test": "bun run test:fixtures && bun run test:resources && bun run --cwd packages/ovule-ioc test && bun run --cwd packages/ovule-ioc-container test && bun run --cwd packages/ovule-extension test && bun run test:vite-plugin && bun run test:architecture && bun run test:smoke-runner",
    "check": "bun run build:extensions && bun run typecheck && bun run lint && bun run test && bun run format:check",
    "test:resources": "node --test scripts/bundled-resources-plugin.test.mjs",
    "build:resources": "node scripts/stage-bundled-resources.mjs",
    "test:smoke-runner": "node --test smoke/runner.test.mjs smoke/relay-options.test.mjs",
    "smoke:turn": "node smoke/remote-control-e2e.mjs --connection-only --require-relay",
    "smoke:workbench-window": "node smoke/workbench-window.mjs",
    "smoke:shell-api-status": "node smoke/shell-api-status.mjs",
    "smoke:office": "node smoke/office-bundle-smoke.mjs",
    "test:fixtures": "bun smoke/build-fixtures.mjs",
    "smoke:draft-tabs": "node smoke/draft-tabs.mjs",
    "smoke:control-feedback": "node smoke/control-feedback-smoke.mjs",
    "smoke:harness": "node smoke/harness-native.mjs",
    "eval:harness": "python3 ../scripts/harness_eval.py",
    "smoke:agent-approval": "node smoke/agent-approval-smoke.mjs",
    "smoke:chat-stream": "node smoke/chat-stream-smoke.mjs",
    "smoke:message-attachments": "node smoke/message-attachments-smoke.mjs",
    "smoke:isolated-native": "node smoke/isolated-native.mjs"
  },
  "dependencies": {
    "tuffite": "git+https://github.com/tuffite/tuffite.git#4b1498ac309edecdc55f12eeb93db1816b6204f4",
    "@ovule/ioc": "workspace:*",
    "@ovule/ui": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@milkdown/crepe": "7.22.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "i18next": "25.6.0",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "16.2.1",
    "react-router": "8.3.1",
    "spice-client": "1.2.0",
    "streamdown": "2.6.0",
    "zustand": "5.0.15",
    "@ovule/ioc-container": "workspace:*",
    "@ovule/shell-api": "workspace:*",
    "@ovule/remoting": "workspace:*",
    "@ovule/settings": "workspace:*",
    "@ovule/connected-apps": "workspace:*",
    "@ovule/shell": "workspace:*",
    "@ovule/workspace": "workspace:*",
    "@ovule/terminal": "workspace:*",
    "@ovule/browser": "workspace:*",
    "@ovule/workbench": "workspace:*",
    "@ovule/workflow": "workspace:*",
    "@ovule/message-parts": "workspace:*",
    "@ovule/hosts": "workspace:*",
    "@ovule/framework": "workspace:*",
    "@ovule/i18n": "workspace:*",
    "@ovule/conversation": "workspace:*",
    "@ovule/omnibox": "workspace:*",
    "@ovule/sidebar": "workspace:*",
    "@ovule/panes": "workspace:*",
    "@ovule/files": "workspace:*",
    "@streamdown/code": "2.0.0",
    "pdfjs-dist": "5.4.149",
    "@ovule/file-types": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "ws": "8.21.3",
    "@typescript-eslint/parser": "8.46.1",
    "eslint": "9.39.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-import-resolver-typescript": "4.4.5"
  },
  "workspaces": [
    "features/*",
    "packages/ovule-*",
    "extensions/*"
  ],
  "license": "MIT OR Apache-2.0"
}
