{
  "id": "io.ovule.channel.sample",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "schemaVersion": 1,
  "apiVersion": 1,
  "runtime": {
    "kind": "javascript",
    "entry": "dist/extension.mjs"
  },
  "contributes": {
    "toolchains": [
      {
        "id": "channel-cli",
        "label": "Channel CLI",
        "kind": "cli",
        "onboarding": false,
        "executable": "channel-cli",
        "candidates": ["channel-cli"],
        "versionArgs": ["--version"],
        "requiredToolchainIds": ["nodejs"],
        "provider": {
          "type": "npm",
          "package": "@example/cli",
          "version": "1.0.94",
          "integrity": "sha512-nzUaXs5l9Z2fEMpKzexNl9MyWMB1494vd+PyCz3QSZHlkjK524k+ne22ikPG7YzbucqKbwVZxNUGIBhSDOilSw==",
          "registry": "https://registry.npmjs.org/",
          "allowScripts": false
        }
      }
    ],
    "agents": [],
    "channels": [
      {
        "id": "channel"
      }
    ],
    "skills": [
      {
        "id": "channel-channel",
        "path": "skills/channel-channel/SKILL.md"
      },
      {
        "id": "channel-cli",
        "path": "skills/channel-cli/SKILL.md"
      }
    ],
    "models": [],
    "slashCommands": [
      {
        "id": "channel",
        "label": "Sample channel",
        "description": "Configure and verify the Channel message channel",
        "handler": "channel.setup",
        "target": "channel",
        "skills": ["channel-channel", "channel-cli"],
        "workflow": "workflows/setup.md",
        "statusBlock": "channel-setup",
        "fallback": {
          "title": "\u914d\u7f6e Channel Bot",
          "intent": "\u8fde\u63a5\u5e76\u9a8c\u8bc1\u73b0\u6709 Channel/\u6d88\u606f\u6e20\u9053\u5e94\u7528\uff0c\u76f4\u5230\u5b8c\u6210 WebSocket \u4e8b\u4ef6\u914d\u7f6e\u3001\u6240\u6709\u8005\u914d\u5bf9\u3001\u771f\u5b9e\u5165\u7ad9\u6d88\u606f\u3001Agent \u6267\u884c\u4e0e\u6301\u4e45\u5316\u56de\u590d\u6295\u9012\u3002",
          "response": "\u5df2\u521b\u5efa Channel Bot \u914d\u7f6e\u4e0e\u7aef\u5230\u7aef\u9a8c\u8bc1\u5de5\u4f5c\u6d41\u3002",
          "nodes": [
            {
              "id": "inspect",
              "kind": "task",
              "title": "\u68c0\u67e5\u5e76\u6062\u590d\u73b0\u6709 Channel Bot \u8fde\u63a5",
              "dependsOn": []
            },
            {
              "id": "authorize",
              "kind": "gate",
              "title": "\u5b8c\u6210 Channel \u5b98\u65b9\u6388\u6743\u4e0e\u6743\u9650\u786e\u8ba4",
              "dependsOn": ["inspect"]
            },
            {
              "id": "provision",
              "kind": "task",
              "title": "\u9a8c\u8bc1 WebSocket \u4e0e im.message.receive_v1 \u914d\u7f6e",
              "dependsOn": ["authorize"]
            },
            {
              "id": "pair-guide",
              "kind": "task",
              "title": "\u51c6\u5907\u6240\u6709\u8005\u914d\u5bf9\u4e0e\u771f\u5b9e\u6d88\u606f\u9a8c\u8bc1\u6b65\u9aa4",
              "dependsOn": ["authorize"]
            },
            {
              "id": "pair",
              "kind": "gate",
              "title": "\u5728\u79c1\u804a\u4e2d\u53d1\u9001 /pair CODE \u5e76\u53d1\u9001\u771f\u5b9e\u6d4b\u8bd5\u6d88\u606f",
              "dependsOn": ["provision", "pair-guide"]
            },
            {
              "id": "verify",
              "kind": "task",
              "title": "\u9a8c\u8bc1\u5165\u7ad9\u6d88\u606f\u3001Agent Turn \u4e0e\u6301\u4e45\u5316 outbox \u56de\u590d",
              "dependsOn": ["pair"]
            }
          ]
        }
      }
    ],
    "actions": [
      {
        "id": "refresh",
        "handler": "channel.status",
        "target": "channel"
      },
      {
        "id": "connect-existing",
        "handler": "channel.registration.start",
        "target": "channel",
        "reuseExisting": true
      }
    ],
    "messageBlocks": [
      {
        "kind": "channel-setup",
        "hostRenderer": "channel-setup",
        "agentInstructions": "Use this block only to display the live Channel channel setup state returned by Ovule. Never place credentials in the payload.",
        "example": {
          "extensionId": "io.ovule.channel.sample",
          "state": "not_configured",
          "detail": "Connect an existing channel app."
        }
      }
    ]
  },
  "permissions": {
    "process": ["node"],
    "network": ["https://api.example.com/*"],
    "secrets": ["app_id", "app_secret"]
  }
}
