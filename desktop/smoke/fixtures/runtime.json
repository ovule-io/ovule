{
  "app": {
    "assets": [
      {
        "file": "desktop/dist/client/index.html",
        "origins": ["ovule://-"],
        "paths": ["/main", "/thread", "/pane", "/explorer", "/", "/index.html"]
      },
      {
        "directory": "desktop/dist/client/assets",
        "origins": ["ovule://-", "ovule://*.artifact", "ovule://*.preview", "ovule://*.local"],
        "paths": ["/assets/*"]
      },
      {
        "file": "desktop/dist/client/shell_api.js",
        "origins": ["ovule://-", "ovule://*.local"],
        "paths": ["/shell_api.js"]
      },
      {
        "directory": "desktop/dist/resources/web/extensions",
        "origins": ["ovule://-", "ovule://*.artifact"],
        "paths": ["/extensions/*"]
      },
      {
        "file": "desktop/dist/client/preview.html",
        "origins": ["ovule://*.local"],
        "paths": [
          "/image",
          "/code",
          "/markdown",
          "/office",
          "/unsupported",
          "/pdf",
          "/preview.html",
          "/html"
        ]
      }
    ],
    "network": {
      "disableHttp2": true,
      "maxResponseBytes": 1048576,
      "timeoutSeconds": 30
    },
    "schemes": ["ovule"],
    "windows": [
      {
        "decorations": false,
        "height": 800,
        "label": "main",
        "maxHeight": 2160,
        "maxWidth": 3840,
        "minHeight": 640,
        "minWidth": 576,
        "title": "Ovule",
        "url": "ovule://-/main",
        "width": 992
      }
    ]
  },
